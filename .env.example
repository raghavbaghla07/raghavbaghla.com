# Safe public Supabase project settings, not a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key, used for validated guest reactions.
SUPABASE_SECRET_KEY=

# Server-only Cloudflare R2 credentials. Never prefix these with NEXT_PUBLIC.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://media.raghavbaghla.com

# Add the email only after creating the mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/raghavbaghla07
