---
import FollowSeries from "../../components/FollowSeries.astro";
import WritingLayout from '../../layouts/WritingLayout.astro';
import { createPublicClient } from '../../lib/supabase';
import { excerpt } from '../../lib/studio-content';
import type { PublishedPost } from '../../lib/studio-content';
import { normalizeArticle,articleStats } from '../../lib/article';
const client = createPublicClient();
let posts: PublishedPost[] = [];
let unavailable = false;
if (client) {
  try {
    const result = await client.from('rb_posts').select('*').order('published_at', {ascending:false}).limit(100);
    if (result.error) unavailable = true;
    else posts = result.data as PublishedPost[];
  } catch { unavailable = true; }
} else unavailable = true;
if (unavailable) Astro.response.status = 503;
Astro.response.headers.set('Cache-Control','no-store');
---
<WritingLayout title="The Afterthoughts · Raghav Baghla">
  <header class="journal-intro">
    <p class="journal-kicker">The journal</p>
    <h1>The Afterthoughts<span>.</span></h1>
    <p>A place for learnings, book notes, and ideas worth keeping.<br class="desktop-break" /> Written slowly. Shared thoughtfully.</p>
    <FollowSeries />
  </header>
  <div class="collection-heading"><h2>All writing</h2><span>{!unavailable && posts.length ? `${posts.length}${posts.length === 100 ? '+' : ''} ${posts.length === 1 ? 'article' : 'articles'}` : 'By Raghav Baghla'}</span></div>
  <div class="posts">
    {unavailable ? <div class="journal-empty"><h2>A little pause.</h2><p>Writing is temporarily unavailable. Please try again shortly.</p></div> : !posts.length ? <div class="journal-empty"><p class="journal-kicker">Something is taking shape</p><h2>The first thought<br />is still on the page.</h2><p>Good ideas take a little time. Come back soon for the first note.</p></div> : posts.map(post => {
      const article = normalizeArticle(post.article,post.body,post.images);
      return <article class:list={['post-card', {'with-cover': Boolean(article.cover)}]}>
        <div class="post-copy">
          <div class="post-meta"><time datetime={post.published_at}>{new Date(post.published_at).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Kolkata'})}</time><span aria-hidden="true">·</span><span>{Math.max(1,articleStats(post.body).minutes)} min read</span></div>
          <h2><a href={`/writing/${encodeURIComponent(post.slug)}/`}>{post.title}</a></h2>
          <p class="post-excerpt">{article.summary || excerpt(post.body)}</p>
          <div class="post-bottom"><span class="read-label" aria-hidden="true">Read article</span>{!!article.tags.length && <div class="post-topics" aria-label="Article topics">{article.tags.slice(0,2).map(tag => <span>{tag}</span>)}</div>}</div>
        </div>
        {article.cover && <img class="post-cover" src={`/media/${article.cover}`} alt={post.images.find(image => image.path === article.cover)?.alt || ''} loading="lazy" />}
      </article>;
    })}
  </div>
</WritingLayout>
<style>
  .journal-intro { padding:88px 0 72px; }
  .journal-kicker { margin:0 0 24px; color:#d4bd9b; font-size:.75rem; letter-spacing:.18em; text-transform:uppercase; }
  h1 { margin:0; max-width:18ch; }
  h1 span { color:#d4bd9b; }
  .journal-intro > p:not(.journal-kicker) { margin:28px 0 0; color:#b4ac9f; font-size:1.0625rem; line-height:1.9; }
  .collection-heading { display:flex; justify-content:space-between; align-items:baseline; gap:20px; padding:22px 0; border-top:1px solid #373027; border-bottom:1px solid #292622; }
  .collection-heading h2 { margin:0; font-size:.875rem; font-weight:400; color:#e5d8c6; }
  .collection-heading > span { font-size:.8125rem; color:#aaa398; }
  .posts { margin-bottom:88px; }
  .post-card { position:relative; display:grid; gap:32px; padding:40px 0; border-bottom:1px solid #292622; }
  .post-card.with-cover { grid-template-columns:minmax(0,1fr) minmax(180px,28%); align-items:center; }
  .post-meta { display:flex; align-items:center; flex-wrap:wrap; gap:10px; color:#aaa398; font-size:.8125rem; line-height:1.7; }
  .post-meta time { color:inherit; }
  .post-card h2 { margin:14px 0; max-width:34ch; font-size:clamp(1.5rem,3vw,2.125rem); font-weight:400; letter-spacing:-.04em; line-height:1.3; overflow-wrap:anywhere; text-wrap:balance; }
  .post-card h2 a { text-decoration:none; }
  .post-card h2 a::after { content:''; position:absolute; inset:0; border-radius:8px; }
  .post-card h2 a:focus-visible::after { outline:2px solid #d4bd9b; outline-offset:8px; }
  .post-card:hover h2 a { color:#e1c9a5; }
  .post-excerpt { max-width:66ch; color:#b4ac9f; font-size:.9375rem; line-height:1.85; margin:0; overflow-wrap:anywhere; }
  .post-bottom { display:flex; align-items:center; gap:20px; flex-wrap:wrap; margin-top:24px; }
  .read-label { color:#d4bd9b; font-size:.8125rem; text-decoration:underline; text-underline-offset:5px; }
  .post-topics { display:flex; flex-wrap:wrap; gap:8px; }
  .post-topics span { max-width:100%; font-size:.75rem; color:#b9ae9a; border:1px solid #383127; border-radius:999px; padding:5px 10px; overflow-wrap:anywhere; }
  .post-cover { width:100%; height:190px; object-fit:cover; border-radius:8px; background:#17140f; }
  .journal-empty { padding:72px 0; max-width:480px; }
  .journal-empty h2 { font-size:clamp(1.75rem,4vw,2.5rem); line-height:1.25; font-weight:400; letter-spacing:-.04em; margin:0 0 20px; }
  .journal-empty > p:last-child { color:#aaa398; font-size:.9375rem; }
  @media(max-width:600px) { .journal-intro { padding:56px 0 44px; } .journal-intro > p:last-child { font-size:1rem; } .desktop-break { display:none; } .post-card.with-cover { grid-template-columns:minmax(0,1fr); } .post-card { gap:24px; padding:28px 0; } .post-cover { grid-row:1; height:210px; } .journal-empty { padding:48px 0; } .collection-heading > span { font-size:.75rem; } }
</style>
