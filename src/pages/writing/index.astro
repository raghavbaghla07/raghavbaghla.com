---
import WritingLayout from '../../layouts/WritingLayout.astro';
import { createPublicClient } from '../../lib/supabase';
import { excerpt } from '../../lib/studio-content';
import type { PublishedPost } from '../../lib/studio-content';
import { normalizeArticle,articleStats } from '../../lib/article';
const client = createPublicClient();
let posts: PublishedPost[] = [];
let unavailable = false;
if (client) {
  try {
    const result = await client.from('rb_posts').select('*').order('published_at', {ascending:false}).limit(100);
    if (result.error) unavailable = true;
    else posts = result.data as PublishedPost[];
  } catch { unavailable = true; }
} else unavailable = true;
if (unavailable) Astro.response.status = 503;
Astro.response.headers.set('Cache-Control','no-store');
---
<WritingLayout>
  <p class="eyebrow">Notes from my corner of the internet</p>
  <h1>Things I’m thinking about.</h1>
  <p class="muted">Learnings, books, and ideas worth keeping.</p>
  <div class="posts">
    {unavailable ? <p class="muted">Writing will be here soon. Come back in a little while.</p> : !posts.length ? <p class="muted">The first thought is still taking shape. Check back soon.</p> : posts.map(post => <article class="post-card">
      <time datetime={post.published_at}>{new Date(post.published_at).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Kolkata'})}</time>
      <h2><a href={`/writing/${encodeURIComponent(post.slug)}/`}>{post.title}</a></h2>
      <p class="muted">{normalizeArticle(post.article,post.body,post.images).summary || excerpt(post.body)}</p>
      <span class="muted">{Math.max(1,articleStats(post.body).minutes)} min read</span>
    </article>)}
  </div>
</WritingLayout>
<style>
  .posts { margin-top:60px; }
  .post-card { padding:28px 0; border-top:1px solid #303030; }
  time { font-size:14px; }
  h2 { font-size:clamp(22px,4vw,30px); font-weight:400; letter-spacing:-.035em; line-height:1.4; }
  h2 a { text-decoration:none; }
  h2 a:hover { text-decoration:underline; }
  .post-card p { overflow-wrap:anywhere; }
</style>
