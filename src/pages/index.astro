---
import ContactFooter from '../components/ContactFooter.astro';
export const prerender = true;

const careers = [
  'Writer', 'Designer', 'Founder', 'Filmmaker', 'Teacher', 'Builder',
  'Photographer', 'Researcher', 'Strategist', 'Storyteller', 'Creator', 'Editor',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content="The personal website of Raghav Baghla. A space for ideas, daily learnings, books, and creative work." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400&amp;display=swap" />
    <link rel="canonical" href="https://raghavbaghla.com/" />
    <title>Raghav Baghla</title>
  </head>
  <body>
    <main>
      <div class="introduction">
        <p class="greeting" aria-hidden="true">Hii</p>
        <div class="intro-content">
          <h1>I am Raghav Baghla.</h1>
          <p class="career-lead">an engineer turned…</p>
          <p class="career-answer">figuring it out.</p>
          <nav class="intro-links" aria-label="Quick links">
            <a class="contact-link" href="#contact">Contact me <span aria-hidden="true">↗</span></a>
            <a href="/studio/">Open studio <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
        <div class="career-scene" aria-hidden="true">
          <div class="career-cloud">
            {careers.map((career, index) => (
              <span style={`--i:${index};--direction:${index % 2 === 0 ? -1 : 1};--depth:${[140, 20, -110, -40][index % 4]}px`}>{career}</span>
            ))}
          </div>
        </div>
      </div>
    </main>
    <nav class="writing-link" aria-label="Writing"><a id="writing-link" href="/writing/" hidden>Writing</a></nav>
    <ContactFooter />
    <script>
      window.setTimeout(() => {
        void fetch('/api/writing-status').then(response => response.ok ? response.json() : null).then(data => {
          const link = document.getElementById('writing-link');
          if (link && data?.hasPosts === true) link.hidden = false;
        }).catch(() => {});
      }, 2700);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: 'Satoshi', system-ui, sans-serif;
    background: #080808;
    color: #eaeaea;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  ::selection { background: #f2f0eb; color: #090909; }
  main {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 7vw, 8rem);
  }
  .introduction {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    padding-block: 3rem;
    text-align: center;
  }
  .introduction > * { grid-area: 1 / 1; }
  .greeting {
    margin: 0;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
    animation: greeting 1800ms ease-in-out both;
  }
  h1 {
    max-width: 24ch;
    margin: 0 auto;
    font-size: clamp(2.25rem, 6.5vw, 4.75rem);
    font-weight: 400;
    letter-spacing: -2.5px;
    line-height: 1.07;
    animation: arrive 900ms cubic-bezier(0.2, 0.7, 0.2, 1) 1800ms both;
  }
  @media (min-width: 1024px) {
    h1 { font-size: clamp(68px, 5.5vw, 76px); }
  }
  .intro-content {
    width: 100%;
    min-width: 0;
    animation: intro-scenes 7600ms ease both;
  }
  .career-lead {
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    color: #b8b5ae;
    font-size: clamp(0.95rem, 1.8vw, 1.5rem);
    animation: arrive 500ms ease 2650ms both;
  }
  .career-scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 900px;
    pointer-events: none;
  }
  .career-cloud {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1.25rem, 5vw, 4rem) 0.4rem;
    width: min(100%, 52rem);
    color: #eaeaea;
    font-size: clamp(0.8rem, 3vw, 2.25rem);
    transform-style: preserve-3d;
    animation: turn-scene 3s ease-in-out 4100ms both;
  }
  .career-cloud span {
    animation: fly-through 2200ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(4120ms + var(--i) * 75ms) both;
  }
  .career-answer {
    margin: 0.3rem 0 clamp(1.5rem, 4vw, 2.5rem);
    color: #eaeaea;
    font-size: clamp(1.35rem, 3vw, 2.65rem);
    letter-spacing: -0.04em;
    animation: arrive 650ms cubic-bezier(0.2, 0.7, 0.2, 1) 7480ms both;
  }
  .intro-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: 100%;
    animation: arrive 600ms ease 7720ms both;
  }
  .intro-links a {
    color: #a8a59e;
    font-size: 0.875rem;
    text-decoration: none;
    padding: 0.75rem 1rem;
    border: 1px solid #393835;
    border-radius: 999px;
  }
  .intro-links .contact-link { background: #f2f0eb; color: #090909; border-color: #f2f0eb; }
  .intro-links a:hover { border-color: #a8a59e; text-decoration: underline; text-underline-offset: 4px; }
  .intro-links a:focus-visible { outline: 2px solid #f2f0eb; outline-offset: 5px; }
  .writing-link { margin-top:-60px; height:60px; text-align:center; animation:arrive 600ms ease 7720ms both; }
  .writing-link a { color:#a8a59e; font-size:14px; text-underline-offset:5px; }
  @keyframes greeting {
    0% { opacity: 0; visibility: visible; }
    25%, 70% { opacity: 1; visibility: visible; }
    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes arrive {
    from { opacity: 0; visibility: hidden; transform: translateY(0.5rem); }
    to { opacity: 1; visibility: visible; transform: translateY(0); }
  }
  @keyframes intro-scenes {
    0%, 49% { opacity: 1; }
    54%, 94% { opacity: 0; }
    100% { opacity: 1; }
  }
  @keyframes turn-scene {
    from { transform: rotateY(-16deg) rotateX(8deg); }
    to { transform: rotateY(13deg) rotateX(-7deg); }
  }
  @keyframes fly-through {
    0% { opacity: 0; visibility: hidden; transform: translate3d(calc(var(--direction) * 1.4rem), -1.6rem, -560px) rotateY(calc(var(--direction) * 58deg)); }
    30%, 65% { opacity: 1; visibility: visible; transform: translateZ(var(--depth)) rotateY(calc(var(--direction) * 10deg)); }
    100% { opacity: 0; visibility: hidden; transform: translate3d(calc(var(--direction) * 1rem), 0.4rem, 300px) rotateY(calc(var(--direction) * -25deg)); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; }
    .greeting, .career-scene { display: none; }
  }
</style>
