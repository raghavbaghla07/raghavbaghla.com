---
import ContactFooter from '../components/ContactFooter.astro';
export const prerender = true;

const careers = [
  'Writer', 'Designer', 'Founder', 'Filmmaker', 'Teacher', 'Builder',
  'Photographer', 'Researcher', 'Strategist', 'Storyteller', 'Creator', 'Editor',
  'Architect', 'Musician', 'Inventor', 'Chef', 'Illustrator', 'Journalist',
  'Animator', 'Explorer', 'Podcaster', 'Producer', 'Mentor', 'Director',
  'Developer', 'Analyst', 'Scientist', 'Publisher', 'Poet', 'Dancer',
  'Composer', 'Painter', 'Reporter', 'Curator', 'Maker', 'Speaker',
  'Dreamer', 'Thinker', 'Traveler', 'Coach', 'Collector', 'Consultant',
  'Investigator', 'Sculptor', 'Typographer', 'Cartographer', 'Artisan', 'Gardener',
];

const goldenAngle = Math.PI * (3 - Math.sqrt(5));
// Spread words across a sphere using evenly spaced heights and golden-angle turns.
const sphereWords = careers.map((word, index) => {
  const y = 1 - (2 * (index + 0.5)) / careers.length;
  const ring = Math.sqrt(1 - y * y);
  const azimuth = index * goldenAngle;
  const x = ring * Math.sin(azimuth);
  const z = ring * Math.cos(azimuth);
  const tilt = -Math.asin(y) * 180 / Math.PI;
  const turn = (azimuth * 180 / Math.PI) % 360;
  return { word, style: `--i:${index};--x:${x.toFixed(4)};--y:${y.toFixed(4)};--z:${z.toFixed(4)};--tilt:${tilt.toFixed(2)}deg;--turn:${turn.toFixed(2)}deg` };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content="The personal website of Raghav Baghla. A space for ideas, daily learnings, books, and creative work." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400&amp;display=swap" />
    <link rel="canonical" href="https://raghavbaghla.com/" />
    <title>Raghav Baghla</title>
  </head>
  <body>
    <main>
      <div class="introduction">
        <p class="greeting" aria-hidden="true">Hii</p>
        <div class="intro-content">
          <h1><span class="intro-prefix">I am</span> Raghav Baghla.</h1>
          <p class="career-lead">an engineer turned…</p>
        </div>
        <div class="intro-ending">
          <p class="career-answer">Figuring <span>it out.</span></p>
          <section class="published-work" aria-labelledby="work-title">
            <div class="work-header">
              <h2 id="work-title">Published work</h2>
              <a href="/writing/">All writing</a>
            </div>
            <div class="work-grid" id="recent-work"></div>
          </section>
        </div>
        <div class="career-scene" aria-hidden="true">
          <div class="career-sphere">
            {sphereWords.map(({ word, style }) => <span style={style}>{word}</span>)}
          </div>
        </div>
      </div>
    </main>
    <ContactFooter />
    <div class="studio-link"><a href="/studio/">Open studio</a></div>
    <script>
      interface WorkPreview { href: string; title: string; summary: string; publishedAt: string }

      const dateFormat = new Intl.DateTimeFormat('en-IN', {
        day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata',
      });
      void fetch('/api/writing-status').then(async response => {
        if (!response.ok) return;
        const { posts } = await response.json() as { posts?: WorkPreview[] };
        if (!posts?.length) return;

        const cards = posts.map((post, index) => {
          const card = document.createElement('article');
          card.className = 'work-card';
          card.style.setProperty('--card-order', String(index));

          const date = document.createElement('time');
          date.dateTime = post.publishedAt;
          date.textContent = dateFormat.format(new Date(post.publishedAt));

          const heading = document.createElement('h3');
          const link = document.createElement('a');
          link.href = post.href;
          link.textContent = post.title;
          heading.append(link);
          card.append(date, heading);

          if (post.summary) {
            const summary = document.createElement('p');
            summary.textContent = post.summary;
            card.append(summary);
          }
          return card;
        });
        document.getElementById('recent-work')?.replaceChildren(...cards);
      }).catch(() => { /* The archive link is available if the preview request fails. */ });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ending-start: 6260ms;
    --accent-ink: #d4bd9b;
    --paper-ink: #f1ede5;
    color-scheme: dark;
    font-family: 'Satoshi', system-ui, sans-serif;
    background: #080808;
    color: #eaeaea;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  ::selection { background: #f2f0eb; color: #090909; }
  main {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 7vw, 8rem);
    background: radial-gradient(ellipse at 50% 44%, #201b16 0%, #110f0d 36%, transparent 72%);
  }
  main::before {
    position: absolute;
    inset: clamp(.75rem, 2.4vw, 2.5rem);
    border: 1px solid #d4bd9b28;
    pointer-events: none;
    content: '';
  }
  .introduction {
    --sphere-start: 3500ms;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    padding-block: 3rem;
    text-align: center;
  }
  .introduction > * { grid-area: 1 / 1; }
  .greeting {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.25rem);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: .95;
    animation: greeting 1800ms ease-in-out both;
  }
  h1 {
    max-width: 24ch;
    margin: 0 auto;
    font-size: clamp(2.25rem, 6.5vw, 4.75rem);
    font-weight: 400;
    letter-spacing: -2.5px;
    line-height: 1.07;
    animation: arrive 900ms cubic-bezier(0.2, 0.7, 0.2, 1) 1800ms both;
  }
  @media (min-width: 1024px) {
    h1 { font-size: clamp(68px, 5.5vw, 76px); }
  }
  .intro-prefix { color: #b4b4b4; }
  @supports (background-clip: text) {
    .intro-prefix {
      background: linear-gradient(100deg, #999 0%, #eaeaea 100%);
      background-clip: text;
      color: transparent;
    }
  }
  @media (forced-colors: active) {
    .intro-prefix { background: none; color: CanvasText; }
  }
  .intro-content {
    width: 100%;
    min-width: 0;
    animation: intro-out 340ms ease 3180ms forwards;
  }
  .career-lead {
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    color: var(--accent-ink);
    font-size: clamp(1.05rem, 2.1vw, 1.55rem);
    line-height: 1.3;
    animation: arrive 420ms ease 2460ms both;
  }
  .career-scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 900px;
    pointer-events: none;
  }
  .career-sphere {
    --radius: clamp(5.4rem, 29vw, 12.5rem);
    position: relative;
    width: 0;
    height: 0;
    color: var(--paper-ink);
    font-size: clamp(0.7rem, 2.2vw, 1.2rem);
    transform-style: preserve-3d;
    animation: sphere-turn 2.65s linear var(--sphere-start) both;
  }
  .career-sphere span {
    --position: translate3d(calc(var(--x) * var(--radius)), calc(var(--y) * var(--radius)), calc(var(--z) * var(--radius)));
    --orientation: rotateY(var(--turn)) rotateX(var(--tilt));
    position: absolute;
    inset: 0 auto auto 0;
    white-space: nowrap;
    backface-visibility: hidden;
    animation: sphere-word 2060ms ease-in-out calc(var(--sphere-start) + var(--i) * 12ms) both;
  }
  .intro-ending {
    width: 100%;
    animation: arrive 650ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--ending-start) both;
  }
  .career-answer {
    margin: 0 auto clamp(1.75rem, 4.5vw, 3rem);
    color: var(--paper-ink);
    font-size: clamp(2.6rem, 6.6vw, 6.25rem);
    line-height: 1.02;
    letter-spacing: -.055em;
    text-wrap: balance;
  }
  .career-answer span { color: #e4ddd1; white-space: nowrap; }
  .published-work {
    position: relative;
    max-width: 52rem;
    margin: 0 auto;
    text-align: left;
    animation: work-reveal 750ms cubic-bezier(.2,.7,.2,1) calc(var(--ending-start) + 650ms) both;
  }
  .published-work::before {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, var(--accent-ink), #5b5044 55%, transparent);
    transform-origin: left;
    animation: rule-reveal 900ms cubic-bezier(.2,.7,.2,1) calc(var(--ending-start) + 650ms) both;
  }
  .work-header {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-block: .5rem;
  }
  .work-header h2 { margin: 0; color: var(--accent-ink); font-size: .8rem; font-weight: 400; letter-spacing: .12em; text-transform: uppercase; }
  .work-header a, .studio-link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #c6beb2;
    font-size: .875rem;
    text-underline-offset: .25em;
  }
  .work-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: .75rem; }
  .work-card {
    position: relative;
    min-width: 0;
    padding: 1rem 1.15rem;
    border: 1px solid #514639;
    border-radius: .65rem;
    background: #191612;
    overflow-wrap: anywhere;
    animation: work-reveal 650ms cubic-bezier(.2,.7,.2,1) both;
    animation-delay: calc(var(--ending-start) + 890ms + var(--card-order) * 110ms);
  }
  .work-card time { color: #b5a898; font-size: .8125rem; }
  .work-card h3 { margin: .35rem 0 0; font-size: clamp(1.125rem, 2.2vw, 1.5rem); font-weight: 400; color: var(--paper-ink); }
  .work-card h3 a { color: inherit; text-decoration: none; }
  .work-card h3 a::after { position: absolute; inset: 0; content: ''; border-radius: .65rem; }
  .work-card h3 a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .work-card p { margin: .35rem 0 0; color: #bcb3a7; font-size: .9rem; line-height: 1.55; }
  .studio-link { width: calc(100% - clamp(3rem, 12vw, 10rem)); max-width: 68rem; margin: 0 auto; border-top: 1px solid #34302a; padding: .75rem 0 1.5rem; }
  .work-header a:focus-visible, .work-card a:focus-visible, .studio-link a:focus-visible { outline: 2px solid var(--paper-ink); outline-offset: 4px; }
  @keyframes work-reveal {
    from { opacity: 0; visibility: hidden; transform: translateY(1rem); }
    to { opacity: 1; visibility: visible; transform: translateY(0); }
  }
  @keyframes rule-reveal {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes greeting {
    0% { opacity: 0; visibility: visible; }
    25%, 70% { opacity: 1; visibility: visible; }
    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes arrive {
    from { opacity: 0; visibility: hidden; transform: translateY(0.5rem); }
    to { opacity: 1; visibility: visible; transform: translateY(0); }
  }
  @keyframes intro-out {
    to { opacity: 0; }
  }
  @keyframes sphere-turn {
    from { transform: rotateX(-12deg) rotateY(-30deg); }
    to { transform: rotateX(-12deg) rotateY(305deg); }
  }
  @keyframes sphere-word {
    0% { opacity: 0; transform: translate(-50%, -50%) scale3d(.22, .22, .22) var(--position) var(--orientation); }
    22%, 80% { opacity: 1; transform: translate(-50%, -50%) var(--position) var(--orientation); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale3d(1.22, 1.22, 1.22) var(--position) var(--orientation); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; }
    .greeting, .career-scene { display: none; }
    .intro-content { position: absolute; opacity: 0; }
  }
  @media (forced-colors: active) {
    main::before { border-color: CanvasText; }
  }
</style>
