<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content="The personal website of Raghav Baghla. A space for ideas, daily learnings, books, and creative work." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://raghavbaghla.com/" />
    <title>Raghav Baghla</title>
  </head>
  <body>
    <main>
      <div class="introduction">
        <p class="greeting">Hii<span class="comma">,</span></p>
        <h1><span class="lead">I am </span><span class="name">Raghav Baghla<span class="period" aria-hidden="true">.</span></span></h1>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Georgia, 'Times New Roman', serif;
    background: #090909;
    color: #f2f0eb;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  ::selection { background: #f2f0eb; color: #090909; }
  main {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 7vw, 8rem);
  }
  .introduction { width: 100%; padding-block: 3rem; text-align: center; }
  .greeting {
    margin: 0 0 clamp(1.25rem, 3vw, 3rem);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
    animation: arrive 700ms ease-out both;
  }
  .comma, .period { color: #a8a59e; }
  h1 {
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.07;
    animation: arrive 1000ms cubic-bezier(0.2, 0.7, 0.2, 1) 900ms both;
  }
  .lead { color: #a8a59e; }
  @keyframes arrive {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 40rem) {
    h1 { max-width: 10ch; }
    .name { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; }
  }
</style>
