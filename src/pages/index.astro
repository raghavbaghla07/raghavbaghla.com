---
import '@fontsource/montserrat/latin-400.css';
import ContactFooter from '../components/ContactFooter.astro';
export const prerender = true;

const careers = [
  'Writer', 'Designer', 'Founder', 'Filmmaker', 'Teacher', 'Builder',
  'Photographer', 'Researcher', 'Strategist', 'Storyteller', 'Creator', 'Editor',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content="The personal website of Raghav Baghla. A space for ideas, daily learnings, books, and creative work." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://raghavbaghla.com/" />
    <title>Raghav Baghla</title>
  </head>
  <body>
    <main>
      <div class="introduction">
        <p class="greeting" aria-hidden="true">Hii</p>
        <div class="intro-content">
          <h1><span class="lead">I am </span><span class="name">Raghav Baghla<span class="period" aria-hidden="true">.</span></span></h1>
          <p class="career-lead">an engineer turned…</p>
          <div class="career-stage">
            <div class="career-cloud" aria-hidden="true">
              {careers.map((career, index) => (
                <span style={`--i:${index};--drift:${index % 2 === 0 ? -12 : 12}px`}>{career}</span>
              ))}
            </div>
            <p class="career-answer">figuring it out.</p>
          </div>
          <nav class="intro-links" aria-label="Quick links">
            <a class="contact-link" href="#contact">Contact me <span aria-hidden="true">↗</span></a>
            <a href="/studio/">Open studio <span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </div>
    </main>
    <nav class="writing-link" aria-label="Writing"><a id="writing-link" href="/writing/" hidden>Writing</a></nav>
    <ContactFooter />
    <script>
      window.setTimeout(() => {
        void fetch('/api/writing-status').then(response => response.ok ? response.json() : null).then(data => {
          const link = document.getElementById('writing-link');
          if (link && data?.hasPosts === true) link.hidden = false;
        }).catch(() => {});
      }, 2700);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: 'Montserrat', system-ui, sans-serif;
    background: #090909;
    color: #f2f0eb;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  ::selection { background: #f2f0eb; color: #090909; }
  main {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 7vw, 8rem);
  }
  .introduction {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    padding-block: 3rem;
    text-align: center;
  }
  .introduction > * { grid-area: 1 / 1; }
  .greeting {
    margin: 0;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
    animation: greeting 1800ms ease-in-out both;
  }
  .period { color: #a8a59e; }
  h1 {
    max-width: 24ch;
    margin: 0 auto;
    font-size: clamp(1.75rem, 4.5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.07;
    animation: arrive 900ms cubic-bezier(0.2, 0.7, 0.2, 1) 1800ms both;
  }
  .lead { color: #a8a59e; }
  .intro-content { width: 100%; min-width: 0; }
  .career-lead {
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    color: #b8b5ae;
    font-size: clamp(0.95rem, 1.8vw, 1.5rem);
    animation: arrive 500ms ease 2650ms both;
  }
  .career-stage {
    display: grid;
    place-items: center;
    min-height: 7rem;
    margin: 0.35rem auto 0.8rem;
  }
  .career-stage > * { grid-area: 1 / 1; }
  .career-cloud {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem clamp(0.25rem, 2vw, 1.5rem);
    width: min(100%, 30rem);
    color: #a8a59e;
    font-size: clamp(0.68rem, 1.05vw, 0.9rem);
  }
  .career-cloud span {
    animation: drift-in 1550ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(3000ms + var(--i) * 75ms) both;
  }
  .career-answer {
    margin: 0;
    color: #e2e9d3;
    font-size: clamp(1.35rem, 3vw, 2.65rem);
    letter-spacing: -0.04em;
    animation: arrive 650ms cubic-bezier(0.2, 0.7, 0.2, 1) 5425ms both;
  }
  .intro-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: 100%;
    animation: arrive 600ms ease 5800ms both;
  }
  .intro-links a {
    color: #a8a59e;
    font-size: 0.875rem;
    text-decoration: none;
    padding: 0.75rem 1rem;
    border: 1px solid #393835;
    border-radius: 999px;
  }
  .intro-links .contact-link { background: #f2f0eb; color: #090909; border-color: #f2f0eb; }
  .intro-links a:hover { border-color: #a8a59e; text-decoration: underline; text-underline-offset: 4px; }
  .intro-links a:focus-visible { outline: 2px solid #f2f0eb; outline-offset: 5px; }
  .writing-link { margin-top:-60px; height:60px; text-align:center; animation:arrive 900ms ease 2700ms both; }
  .writing-link a { color:#a8a59e; font-size:14px; text-underline-offset:5px; }
  @keyframes greeting {
    0% { opacity: 0; visibility: visible; }
    25%, 70% { opacity: 1; visibility: visible; }
    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes arrive {
    from { opacity: 0; visibility: hidden; transform: translateY(0.5rem); }
    to { opacity: 1; visibility: visible; transform: translateY(0); }
  }
  @keyframes drift-in {
    0% { opacity: 0; visibility: hidden; transform: translate(var(--drift), -1.35rem) scale(.94); }
    38%, 64% { opacity: 1; visibility: visible; transform: translate(0) scale(1); }
    100% { opacity: 0; visibility: hidden; transform: translateY(0.5rem) scale(.97); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; }
    .greeting, .career-cloud { display: none; }
  }
</style>
