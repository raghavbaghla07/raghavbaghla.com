---
import { optedOut } from '../lib/readership';
import WritingLayout from '../layouts/WritingLayout.astro';
import EmailSubscription from '../components/EmailSubscription.astro';
import { privateResponseHeaders, subscriptionClient, validSubscriptionToken } from '../lib/email-subscriptions';

for (const [name, value] of Object.entries(privateResponseHeaders)) Astro.response.headers.set(name, value);
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const messages: Record<string, string> = {
  requested: 'If this address is new, we’ll email you a link to confirm your follow. Open it to start receiving updates.',
  confirmed: 'You’ll receive an email when a new post is published in The Afterthoughts.',
  unsubscribed: 'You’re no longer following The Afterthoughts.',
  invalid: 'Enter a valid email address to follow The Afterthoughts.',
  expired: 'This confirmation link has expired. Enter your email to request a new one.',
  unavailable: 'Following by email is temporarily unavailable. Please try again shortly.',
};
const status = Astro.url.searchParams.get('status') ?? '';
const action = Astro.url.searchParams.get('action');
const token = Astro.url.searchParams.get('token');
const managing = (action === 'confirm' || action === 'unsubscribe') && validSubscriptionToken(token);

if (Astro.request.method === 'POST') {
  if (Astro.request.headers.get('origin') !== Astro.url.origin || !managing) {
    return new Response(null, { status: 403, headers: privateResponseHeaders });
  }
  const client = subscriptionClient();
  if (!client) return Astro.redirect('/subscription/?status=unavailable', 303);
  if (action === 'confirm') {
    const skip = optedOut(Astro.request.headers) || (await Astro.request.formData()).get('privacy') === '1';
    const result = await client.rpc('rb_confirm_private_email', { p_token: token, p_skip_attribution: skip });
    const outcome = result.error ? 'unavailable' : result.data ? 'confirmed' : 'expired';
    return Astro.redirect('/subscription/?status=' + outcome, 303);
  }
  const result = await client.rpc('rb_unsubscribe_email', { p_token: token });
  return Astro.redirect('/subscription/?status=' + (result.error ? 'unavailable' : 'unsubscribed'), 303);
}

const title = managing
  ? action === 'confirm' ? 'Confirm your follow' : 'Unfollow The Afterthoughts'
  : status === 'requested' ? 'Check your inbox'
  : status === 'confirmed' ? 'You’re following The Afterthoughts'
  : 'Follow The Afterthoughts';
---
<WritingLayout title={title + ' · Raghav Baghla'}>
  <div class="subscription-page">
    <h1>{title}</h1>
    {managing ? (
      <form method="post" data-confirmation>
        <p>{action === 'confirm' ? 'Get an email when a new post is published in The Afterthoughts.' : 'Stop getting emails about new posts in The Afterthoughts.'}</p>
        <button type="submit">{action === 'confirm' ? 'Confirm follow' : 'Unfollow'}</button>
      </form>
    ) : (
      <>
        {Object.hasOwn(messages, status) && <p role="status">{messages[status]}</p>}
        {(!Object.hasOwn(messages, status) || status === 'invalid' || status === 'expired' || status === 'unavailable') && <EmailSubscription expanded />}
      </>
    )}
    <p><a href="/writing/">Back to The Afterthoughts</a></p>
  </div>
</WritingLayout>
<script>
  import { browserOptOut } from '../lib/readership';
  document.querySelector<HTMLFormElement>('[data-confirmation]')?.addEventListener('formdata', event => {
    if (browserOptOut(navigator)) event.formData.set('privacy', '1');
  });
</script>
<style>
  .subscription-page { max-width:680px; margin:4rem 0; }
  h1 { font-size:clamp(2rem,5vw,3.5rem); }
  button { min-height:44px; font:inherit; padding:.65rem .9rem; border:1px solid #77674f; border-radius:5px; background:#ddc6a3; color:#211b15; cursor:pointer; }
  a { color:#d4bd9b; }
</style>
