---
const email = 'hello@raghavbaghla.com';
---
<footer id="contact" class="contact-footer" aria-labelledby="contact-heading">
  <div class="contact-intro">
    <h2 id="contact-heading">Let’s talk.</h2>
    <p>Have an idea, a question, or just want to say hi?</p>
    <div class="contact-method">
      <span class="contact-email">{email}</span>
      <a class="email-action" href={`mailto:${email}`}>Email me <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="socials">
    <p class="eyebrow">Elsewhere</p>
    <nav aria-label="Social links">
      <a href="https://www.linkedin.com/in/raghavbaghla07" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href="https://www.instagram.com/raghavbaghla23" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
      <a href="https://youtube.com/@raghavbaghla07" target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</footer>
<style>
  .contact-footer {
    max-width: 68rem;
    width: calc(100% - clamp(3rem, 12vw, 10rem));
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 7rem) 0;
    border-top: 1px solid #34302a;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 16rem);
    gap: clamp(2.25rem, 9vw, 8rem);
    color: #bcb5ab;
    font-size: 1rem;
    line-height: 1.55;
    scroll-margin-top: 24px;
  }
  .eyebrow { margin: 0 0 .75rem; color: var(--accent-ink, #bcb5ab); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; }
  h2 {
    margin: 0;
    color: var(--paper-ink, #f2f0eb);
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: 1;
  }
  .contact-intro > p { margin: .9rem 0 1.55rem; }
  nav { display: grid; border-top: 1px solid #34302a; }
  nav a { display: flex; justify-content: space-between; align-items: center; min-height: 44px; border-bottom: 1px solid #34302a; }
  nav span { color: var(--accent-ink, #bcb5ab); }
  a { color:inherit; text-decoration:none; text-underline-offset:5px; }
  a:hover { color:#f2f0eb; text-decoration:underline; }
  a:focus-visible { outline:2px solid #c9d8bb; outline-offset:5px; }
  .contact-method { display:flex; flex-direction:column; align-items:flex-start; gap:14px; }
  .contact-email { color:#f2f0eb; font-size:clamp(1rem,2.5vw,1.25rem); overflow-wrap:anywhere; }
  .email-action { display:inline-flex; align-items:center; gap:8px; min-height:44px; padding:0 16px; border:1px solid #45443f; border-radius:999px; color:#f2f0eb; }
  .email-action:hover { background:#22211e; border-color:#8a8880; text-decoration:none; }
  .socials { padding-top: .65rem; }
  @media (max-width: 620px) {
    .contact-footer { grid-template-columns: minmax(0, 1fr); }
  }
</style>
