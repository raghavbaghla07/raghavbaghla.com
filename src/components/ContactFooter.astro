---
const email = 'hello@raghavbaghla.com';
---
<footer id="contact" class="contact-footer" aria-labelledby="contact-heading">
  <div class="contact-intro">
    <p class="eyebrow">Contact me</p>
    <h2 id="contact-heading">Let’s talk.</h2>
    <p>Have an idea, a question, or just want to say hi?</p>
    <div class="contact-method">
      <span class="contact-email">{email}</span>
      <a class="email-action" href={`mailto:${email}`}>Email me <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="socials">
  <p class="eyebrow">Find me here</p>
  <nav aria-label="Social links">
    <a href="https://www.linkedin.com/in/raghavbaghla07" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href="https://www.instagram.com/raghavbaghla23" target="_blank" rel="noopener noreferrer">Instagram</a>
    <a href="https://youtube.com/@raghavbaghla07" target="_blank" rel="noopener noreferrer">YouTube</a>
  </nav>
  </div>
</footer>
<style>
  .contact-footer { max-width:1080px; margin:0 auto; padding:clamp(48px, 8vw, 88px) 24px; border-top:1px solid #292929; display:flex; justify-content:space-between; align-items:start; gap:40px; color:#b1afa9; font-size:14px; line-height:1.8; scroll-margin-top:24px; }
  .eyebrow { margin:0 0 16px; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; }
  h2 { margin:0; color:#f2f0eb; font-size:clamp(2rem,5vw,3.5rem); font-weight:400; letter-spacing:-0.04em; line-height:1.15; }
  .contact-intro > p:not(.eyebrow) { margin:16px 0 24px; }
  nav { display:flex; flex-wrap:wrap; gap:12px 24px; }
  a { color:inherit; text-decoration:none; text-underline-offset:5px; }
  a:hover { color:#f2f0eb; text-decoration:underline; }
  a:focus-visible { outline:2px solid #c9d8bb; outline-offset:5px; }
  .contact-method { display:flex; flex-direction:column; align-items:flex-start; gap:14px; }
  .contact-email { color:#f2f0eb; font-size:clamp(1rem,3vw,1.5rem); overflow-wrap:anywhere; }
  .email-action { display:inline-flex; align-items:center; gap:8px; min-height:44px; padding:0 16px; border:1px solid #45443f; border-radius:999px; color:#f2f0eb; }
  .email-action:hover { background:#22211e; border-color:#8a8880; text-decoration:none; }
  .socials { padding-top:8px; }
  @media(max-width:760px) { .contact-footer { flex-direction:column; } }
</style>
