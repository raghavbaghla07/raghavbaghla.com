<section class="follow">
  <h2>Follow The Afterthoughts</h2>
  <p>Get new posts in your RSS reader. Create a personal feed, then add its address to your reader to receive updates.</p>
  <button type="button" data-follow>Create my feed</button>
  <div data-feed-details hidden>
    <label>Personal feed address<input data-feed-url readonly type="url" /></label>
    <button type="button" data-copy>Copy address</button>
    <button type="button" data-remove>End subscription</button>
  </div>
  <span data-feedback role="status"></span>
  <a href="/feed.xml">Open public RSS feed</a>
</section>
<script>
  import { createPublicClient } from '../lib/supabase';
  const client = createPublicClient();
  const root = document.querySelector<HTMLElement>('.follow')!;
  const button = root.querySelector<HTMLButtonElement>('[data-follow]')!;
  const details = root.querySelector<HTMLElement>('[data-feed-details]')!;
  const input = root.querySelector<HTMLInputElement>('input')!;
  const remove = root.querySelector<HTMLButtonElement>('[data-remove]')!;
  const feedback = root.querySelector<HTMLElement>('[data-feedback]')!;
  const key = 'rb-personal-feed';
  let token = '';
  try { token = localStorage.getItem(key) || ''; } catch {}
  function render() {
    button.hidden = Boolean(token) || !client;
    details.hidden = !token;
    input.value = token ? new URL('/feed.xml?subscription=' + encodeURIComponent(token), location.origin).href : '';
  }
  async function change(create: boolean) {
    button.disabled = remove.disabled = true;
    try {
      const id = create ? crypto.randomUUID() : token;
      const { error } = await client!.rpc('rb_feed', { p_token: id, p_action: create ? 'create' : 'remove' });
      if (error) throw error;
      token = create ? id : '';
      try { if (token) localStorage.setItem(key, token); else localStorage.removeItem(key); } catch {}
      render();
      feedback.textContent = create ? 'Paste this address into your feed reader to finish subscribing.' : 'Subscription ended.';
      (create ? input : button).focus();
    } catch { feedback.textContent = 'Could not update your subscription. Please try again.'; }
    finally { button.disabled = remove.disabled = false; }
  }
  render();
  button.addEventListener('click', () => void change(true));
  remove.addEventListener('click', () => void change(false));
  root.querySelector('[data-copy]')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(input.value); feedback.textContent = 'Feed address copied.'; }
    catch { input.select(); feedback.textContent = 'Select and copy your feed address.'; }
  });
</script>
<style>
  .follow {max-width:680px;margin:2rem 0;padding:1.5rem;border:1px solid #433b2f;border-radius:10px;background:#171410;color:#ece5db}
  h2 {margin:0;font:400 1.6rem Georgia,serif} p {color:#c5bbae;line-height:1.65}
  button,input {font:inherit;padding:.65rem .9rem;border:1px solid #77674f;border-radius:5px}
  button {background:#ddc6a3;color:#211b15;cursor:pointer} [data-remove] {background:transparent;color:#ded3c2}
  label,input {display:block} input {width:100%;margin:.5rem 0 .75rem} a,span {display:block;font-size:.875rem;margin-top:.8rem} span:empty {display:none}
</style>
