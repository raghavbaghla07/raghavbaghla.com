---
import '../styles/analytics.css';
const sections = ['Overview','Content','Audience','Sources','Notifications'];
---
<section id="analytics-panel" hidden aria-labelledby="analytics-title">
  <header class="analytics-heading">
    <div><h2 id="analytics-title">Analytics</h2><p id="analytics-dates"></p></div>
    <div class="analytics-actions">
      <label>Reporting period<select id="analytics-period">
        <option value="7">Last 7 days</option><option value="30" selected>Last 30 days</option>
        <option value="90">Last 90 days</option><option value="custom">Custom dates</option>
      </select></label>
      <button id="analytics-refresh" type="button">Refresh</button>
    </div>
  </header>
  <form id="analytics-range" hidden>
    <label>From (UTC)<input type="date" id="analytics-from" required min="2000-01-01" /></label>
    <label>Through (UTC)<input type="date" id="analytics-to" required min="2000-01-01" /></label>
    <button>Apply dates</button>
  </form>
  <div class="analytics-tabs" role="tablist" aria-label="Analytics sections">
    {sections.map((section, i) => <button type="button" role="tab" id={'analytics-tab-'+section}
      data-section={section} aria-selected={i===0} tabindex={i===0 ? 0 : -1} aria-controls="analytics-section">{section}</button>)}
  </div>
  <p id="analytics-status" role="status"></p>
  <section id="analytics-section" role="tabpanel" tabindex="0" aria-labelledby="analytics-tab-Overview">
    <div id="analytics-results"></div>
  </section>
</section>
