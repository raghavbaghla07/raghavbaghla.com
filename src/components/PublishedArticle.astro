---
import EmailSubscription from "./EmailSubscription.astro";
import type { PublishedPost } from '../lib/studio-content';
import ArticleEngagement from './ArticleEngagement.astro';
import { normalizeArticle, renderArticle, articleStats } from '../lib/article';
interface Props { post: PublishedPost }
const { post } = Astro.props;
const article = normalizeArticle(post.article, post.body, post.images);
const date = new Date(post.published_at).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric', timeZone:'Asia/Kolkata' });
---
<article class="published-article" data-read-post={post.id}>
  <header class="article-masthead">
    <a class="journal-back" href="/writing/">All writing</a>
    <p class="article-kicker">The Afterthoughts</p>
    <h1>{post.title}</h1>
    {article.summary && <p class="article-deck">{article.summary}</p>}
    <div class="article-byline">
      <div class="article-author"><span class="author-monogram" aria-hidden="true">RB</span><div><span class="author-name">Written by <a href="/" rel="author">Raghav Baghla</a></span><time datetime={post.published_at}>{date}</time></div></div>
      <span class="article-duration">{Math.max(1, articleStats(post.body).minutes)} min read</span>
    </div>
  </header>
  {article.cover && <figure class="article-cover"><img src={`/media/${article.cover}`} alt={post.images.find(image => image.path === article.cover)?.alt || ''} fetchpriority="high" /></figure>}
  <div class="article-reading">
    <div class="article-content" set:html={renderArticle(article, post.images, path => `/media/${path}`)} />
    {!post.article && !!post.images.length && <div class="post-images">{post.images.map(image => <figure><img src={`/media/${image.path}`} alt={image.alt} loading="lazy" /></figure>)}</div>}
    {!!article.tags.length && <div class="article-topics" aria-label="Article topics">{article.tags.map(tag => <span>{tag}</span>)}</div>}
    <EmailSubscription />
    <ArticleEngagement id={post.id} title={post.title} slug={post.slug} />
    <footer class="article-end"><div><p>Thanks for reading.</p><span>More learnings, books, and ideas worth keeping.</span></div><a href="/writing/">Explore all writing</a></footer>
  </div>
</article>
<style>
  .published-article { padding:48px 0 88px; }
  .article-masthead { max-width:840px; margin:0 auto; }
  .journal-back { display:inline-flex; align-items:center; min-height:44px; color:#b9b1a4; font-size:.875rem; text-underline-offset:5px; }
  .article-kicker { margin:44px 0 20px; font-size:.75rem; line-height:1.6; letter-spacing:.15em; text-transform:uppercase; color:#d4bd9b; }
  h1 { margin:0; max-width:20ch; }
  .article-deck { margin:24px 0 0; max-width:62ch; font-size:clamp(1.0625rem,2vw,1.25rem); line-height:1.75; color:#bbb4a8; overflow-wrap:anywhere; }
  .article-byline { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:28px 0; margin-top:32px; border-top:1px solid #302c26; border-bottom:1px solid #302c26; font-size:.8125rem; }
  .article-author { display:flex; align-items:center; gap:14px; }
  .author-monogram { width:44px; height:44px; display:grid; place-items:center; flex-shrink:0; border-radius:50%; background:#242019; border:1px solid #4a3e2e; color:#e1c9a5; font-size:.8125rem; letter-spacing:-.04em; }
  .author-name { display:block; margin-bottom:6px; color:#e9e3d8; }
  .author-name a { text-decoration:none; color:#e7d6bc; } .author-name a:hover { text-decoration:underline; }
  time, .article-duration { color:#aaa398; line-height:1.6; }
  .article-duration { white-space:nowrap; }
  .article-cover { max-width:960px; margin:40px auto 0; }
  .article-cover img { display:block; width:100%; max-height:640px; object-fit:contain; border:1px solid #302c26; border-radius:12px; background:#13120f; }
  .article-reading { max-width:680px; margin:48px auto 0; }
  .article-reading :global(.article-content) { color:#d7d2c9; font-size:1.125rem; line-height:1.95; }
  .article-reading :global(.article-content h2), .article-reading :global(.article-content h3), .article-reading :global(.article-content h4) { color:#f1ede5; }
  .article-reading :global(.article-content h2) { font-weight:400; font-size:1.65em; letter-spacing:-.04em; margin-top:1.9em; }
  .article-reading :global(.article-content strong) { color:#f1ede5; }
  .article-reading :global(.article-content blockquote) { border-color:#c3a67e; color:#d4bd9b; background:#17140f; padding:20px 24px; border-radius:0 8px 8px 0; }
  .article-reading :global(.article-content a) { color:#dfc69f; }
  .article-reading :global(.article-content figcaption) { font-size:.875rem; color:#b3aa9b; }
  .article-topics { display:flex; flex-wrap:wrap; gap:8px; margin:40px 0 0; }
  .article-topics span { max-width:100%; overflow-wrap:anywhere; padding:8px 14px; border:1px solid #3c352a; border-radius:999px; font-size:.8125rem; line-height:1.4; color:#ccbea8; background:#1a1712; }
  .article-end { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:24px; margin-top:48px; padding-top:32px; border-top:1px solid #302c26; }
  .article-end p { margin:0 0 8px; font-size:1.125rem; color:#eee6d9; }
  .article-end span { font-size:.875rem; line-height:1.7; color:#aaa398; }
  .article-end a { display:inline-flex; align-items:center; min-height:44px; color:#dec8a7; font-size:.875rem; }
  @media(max-width:600px) { .published-article { padding:24px 0 64px; } .article-kicker { margin-top:28px; font-size:.6875rem; letter-spacing:.12em; } .article-byline { padding:22px 0; margin-top:28px; gap:12px; } .article-author { gap:10px; } .author-monogram { width:38px; height:38px; } .article-reading { margin-top:32px; } .article-reading :global(.article-content) { font-size:1rem; line-height:1.9; } .article-cover { margin-top:28px; } .article-reading :global(.article-content blockquote) { padding:16px 18px; } }
</style>
