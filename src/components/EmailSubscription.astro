---
import { emailConfigured } from '../lib/email-subscriptions';
interface Props { expanded?: boolean }
const { expanded = false } = Astro.props;
const available = emailConfigured();
const Container = expanded ? 'section' : 'details';
---
<Container class="email-subscription">
  {!expanded && <summary>Follow The Afterthoughts</summary>}
  <p>Get an email when a new post is published in The Afterthoughts. You can unfollow anytime.</p>
  <form method="post" action="/api/subscribe" aria-describedby={!available ? 'subscription-status' : undefined}>
    <input type="hidden" name="topic" value="afterthoughts" />
    <label for="subscription-email">Email address</label>
    <div class="email-fields">
      <input id="subscription-email" name="email" type="email" autocomplete="email" maxlength="254" required disabled={!available} />
      <button type="submit" disabled={!available}>Follow by email</button>
    </div>
  </form>
  {!available && <p id="subscription-status" class="subscription-status">Following by email is temporarily unavailable.</p>}
</Container>
<style>
  .email-subscription { max-width:680px; margin:2rem 0; padding:1.5rem; border:1px solid #433b2f; border-radius:10px; background:#171410; color:#ece5db; }
  summary { cursor:pointer; color:#e6cfad; font:400 1.35rem Georgia,serif; }
  p { color:#c5bbae; line-height:1.65; }
  label { display:block; margin-bottom:.5rem; font-size:.875rem; }
  .email-fields { display:flex; gap:.75rem; flex-wrap:wrap; }
  button,input { min-height:44px; font:inherit; padding:.65rem .9rem; border:1px solid #77674f; border-radius:5px; }
  input { flex:1 1 14rem; min-width:0; background:#100e0b; color:#ece5db; }
  button { background:#ddc6a3; color:#211b15; cursor:pointer; }
  :disabled { opacity:.65; cursor:default; }
  .subscription-status { margin:.75rem 0 0; font-size:.875rem; }
</style>
