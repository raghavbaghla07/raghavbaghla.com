---
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-400-italic.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-700-italic.css';
import ContactFooter from '../components/ContactFooter.astro';
import '../styles/article.css';
const { title = 'Writing · Raghav Baghla', description = 'Thoughts, learnings, and notes by Raghav Baghla.', article = false, image, publishedAt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content={description} />
    <meta name="author" content="Raghav Baghla" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Raghav Baghla" />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    {article && <meta property="article:author" content="Raghav Baghla" />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="The Afterthoughts" href="/feed.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="writing-header"><a class="wordmark" href="/">Raghav Baghla<span>.</span></a><nav aria-label="Main navigation"><a href="/writing/" aria-current="page">Writing</a><a href="#contact">Get in touch</a></nav></header>
    <main id="main" class="writing-main"><slot /></main>
    <script src="../scripts/readership.ts"></script>
    <ContactFooter />
  </body>
</html>
<style is:global>
  :root { --accent-ink:#d4bd9b; --paper-ink:#f1ede5; color-scheme:dark; font-family:'Montserrat',system-ui,sans-serif; background:#090909; color:#f2f0eb; font-synthesis:none; -webkit-font-smoothing:antialiased; }
  * { box-sizing:border-box; }
  body { margin:0; }
  a { color:inherit; text-underline-offset:0.25em; }
  a:hover { color:#fff; }
  :focus-visible { outline:2px solid #c9d8bb; outline-offset:5px; }
  .writing-header { max-width:1120px; margin:auto; padding:28px 24px; display:flex; justify-content:space-between; align-items:center; gap:24px; font-size:.875rem; border-bottom:1px solid #292723; }
  .writing-header a { display:inline-flex; align-items:center; min-height:44px; text-decoration:none; }
  .wordmark { font-size:1rem; letter-spacing:-.04em; color:#f1ede5; }
  .wordmark span { color:var(--accent-ink); }
  .writing-header nav { display:flex; gap:28px; color:#b8b2a8; }
  .writing-header a[aria-current] { color:var(--accent-ink); }
  .writing-header nav a:hover { text-decoration:underline; }
  .writing-main { max-width:1120px; margin:0 auto; padding:0 24px; min-height:50svh; }
  h1 { font-size:clamp(2.35rem,5.5vw,4.5rem); font-weight:400; letter-spacing:-.055em; line-height:1.12; overflow-wrap:anywhere; text-wrap:balance; }
  p { line-height:1.8; }
  .muted, time { color:#aaa8a2; }
  .eyebrow { font-size:14px; color:#aaa8a2; }
  .post-body { white-space:pre-wrap; overflow-wrap:anywhere; font-size:18px; line-height:1.9; }
  .post-images { display:grid; gap:24px; margin-top:32px; }
  .post-images img { width:100%; height:auto; display:block; border-radius:8px; }
  .post-images figure { margin:0; }
  .post-images figcaption { font-size:14px; color:#aaa8a2; margin-top:10px; line-height:1.6; }
  .skip { position:absolute; top:0; left:12px; padding:12px; background:#252525; transform:translateY(-200%); }
  .skip:focus { transform:translateY(0); }
  ::selection { background:#d4bd9b; color:#17130f; }
  @media(max-width:600px) { .writing-header { padding:18px 20px; gap:16px; } .writing-header nav { gap:16px; } .writing-header nav a { font-size:.8125rem; } .writing-main { padding:0 20px; } }
</style>
