---
import '@fontsource/montserrat/latin-400.css';
import ContactFooter from '../components/ContactFooter.astro';
const { title = 'Writing · Raghav Baghla', description = 'Thoughts, learnings, and notes by Raghav Baghla.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header><a href="/">Raghav Baghla.</a><a href="/writing/">Writing</a></header>
    <main id="main"><slot /></main>
    <ContactFooter />
  </body>
</html>
<style is:global>
  :root { color-scheme:dark; font-family:'Montserrat',system-ui,sans-serif; background:#090909; color:#f2f0eb; font-synthesis:none; -webkit-font-smoothing:antialiased; }
  * { box-sizing:border-box; }
  body { margin:0; }
  a { color:inherit; text-underline-offset:0.25em; }
  a:hover { color:#fff; }
  :focus-visible { outline:2px solid #c9d8bb; outline-offset:5px; }
  header { max-width:1080px; margin:auto; padding:32px 24px; display:flex; justify-content:space-between; gap:24px; font-size:14px; }
  header a { text-decoration:none; }
  main { max-width:760px; margin:64px auto 100px; padding:0 24px; min-height:50svh; }
  h1 { font-size:clamp(2rem,5vw,3.5rem); font-weight:400; letter-spacing:-0.045em; line-height:1.15; overflow-wrap:anywhere; }
  p { line-height:1.8; }
  .muted, time { color:#aaa8a2; }
  .eyebrow { font-size:14px; color:#aaa8a2; }
  .post-body { white-space:pre-wrap; overflow-wrap:anywhere; font-size:18px; line-height:1.9; }
  .post-images { display:grid; gap:24px; margin-top:32px; }
  .post-images img { width:100%; height:auto; display:block; border-radius:8px; }
  .post-images figure { margin:0; }
  .post-images figcaption { font-size:14px; color:#aaa8a2; margin-top:10px; line-height:1.6; }
  .skip { position:absolute; top:0; left:12px; padding:12px; background:#252525; transform:translateY(-200%); }
  .skip:focus { transform:translateY(0); }
</style>
